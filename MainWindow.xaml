<Window x:Class="AppAvvio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppAvvio" Icon="Assets/Branding/appavvio.ico" Width="1220" Height="950" MinWidth="1020" MinHeight="850" Background="#F3F6F8" WindowStartupLocation="CenterScreen">
 <Grid Background="#F3F6F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142838"><Grid Margin="20,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#F3F6F8" CornerRadius="12" Padding="8,12"><Image Source="Assets/Branding/appavvio-logo.png" Stretch="Uniform" AutomationProperties.Name="AppAvvio"/></Border><TextBlock Text="Il tuo tempo, prima." Foreground="#9DB2C4" FontSize="12" Margin="0,10,0,0"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,38,0,0"><TextBlock Text="IL TUO SPAZIO" Foreground="#7F99AD" FontSize="10" Margin="16,0,0,12"/><RadioButton Content="☷   Sequenza di avvio" Style="{StaticResource Navigation}" IsChecked="True" Checked="ShowSequence"/><RadioButton x:Name="UpdatesNav" Content="↓   Aggiornamenti" Style="{StaticResource Navigation}" Checked="ShowUpdates"/></StackPanel>
   <StackPanel Grid.Row="2"><Border Height="1" Background="#2B4152" Margin="0,0,0,16"/><TextBlock Text="PENSATO PER WINDOWS" FontSize="10" Foreground="#7F99AD"/><TextBlock x:Name="SidebarVersion" Foreground="#BDCAD5" Margin="0,7,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="32,28,32,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="SequencePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="UN BUON INIZIO" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Prima ciò che conta." FontSize="32" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Text="Scegli le tue app. Dai un ordine alla tua giornata." Foreground="{StaticResource Muted}"/><TextBlock x:Name="SequenceHealthText" Visibility="Collapsed" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis" Foreground="#99510B" Margin="0,12,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button x:Name="ToggleStartupButton" DockPanel.Dock="Right" Content="Disattiva" Click="ToggleWindowsStartup" IsEnabled="False" Padding="10,11"/><Button DockPanel.Dock="Right" Content="Aggiorna elenco" Click="RefreshWindows"/><Button DockPanel.Dock="Right" Content="↓ Nella mia sequenza" Click="ImportSelected"/><TextBlock Text="Avviate da Windows" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ListBox Grid.Row="1" x:Name="WindowsApps" SelectionChanged="WindowsSelectionChanged" BorderThickness="0" AllowDrop="True" Drop="ReturnToWindows" PreviewMouseLeftButtonDown="WindowsDragStart" MouseMove="WindowsDragMove"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" ToolTip="{Binding Details}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>    <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E1E8ED" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="18,16"><Button DockPanel.Dock="Right" Content="＋  Aggiungi app" Style="{StaticResource Primary}" Click="AddApp" Margin="12,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="La tua sequenza" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Trascina per riordinare · doppio clic per modificare" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1"><DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F4" BorderThickness="0" Background="White" MinRowHeight="58" SelectionMode="Single" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" MouseMove="DragMove" Drop="DropItem">
      <DataGrid.Columns><DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled}" Width="52"/><DataGridTextColumn Header="APPLICAZIONE" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="CONFIGURAZIONE" Binding="{Binding Health}" IsReadOnly="True" Width="190"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#99510B"/><Setter Property="ToolTip" Value="{Binding Health}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Style.Triggers><DataTrigger Binding="{Binding Health}" Value="Configurazione OK"><Setter Property="Foreground" Value="#17695D"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="ATTESA (s)" Binding="{Binding DelaySeconds, ValidatesOnExceptions=True}" Width="95"/><DataGridTextColumn Header="PERCORSO" Binding="{Binding Path}" Width="1.2*" MinWidth="120"/><DataGridTextColumn Header="ARGOMENTI" Binding="{Binding Arguments}" Width="100"/><DataGridTextColumn Header="STATO" Binding="{Binding Status}" IsReadOnly="True" Width="140"/></DataGrid.Columns>
     </DataGrid><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,38,0,0"><TextBlock Text="Fai spazio alle tue priorità" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="Aggiungi Discord, WhatsApp o le app che usi ogni giorno." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Grid>
     <DockPanel Grid.Row="2" Margin="16"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="↑" ToolTip="Sposta in alto" Click="MoveUp"/><Button Content="↓" ToolTip="Sposta in basso" Click="MoveDown"/><Button Content="Rimuovi" Click="RemoveApp"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Salva" Click="Save"/><Button x:Name="RunButton" Content="▶  Prova" Style="{StaticResource Primary}" Click="Run"/><Button Content="■" ToolTip="Interrompi sequenza" Click="Stop" Margin="0"/></StackPanel></DockPanel>
    </Grid></Border>
    <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E1E8ED" BorderThickness="1" Padding="18" Margin="0,18,0,0"><StackPanel><CheckBox x:Name="LoginCheck" Content="Avvia AppAvvio quando accedo a Windows" Click="ToggleLogin" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="Controlla conflitti" Click="CheckConflicts" Padding="12,8"/><Button Content="Impostazioni avvio Windows ↗" Click="OpenStartupSettings" Padding="12,8"/></WrapPanel></StackPanel></Border>
   </Grid>
   <Grid x:Name="UpdatesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="SEMPRE AL PASSO" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Ogni versione, un passo avanti." FontSize="30" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Text="Aggiornamenti e novità, direttamente da AppAvvio su GitHub." Foreground="{StaticResource Muted}"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22" BorderBrush="#E1E8ED" BorderThickness="1" Margin="0,0,0,22"><StackPanel><TextBlock x:Name="VersionText" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatus" Text="Controlla se è disponibile una nuova versione." Foreground="{StaticResource Muted}" Margin="0,8,0,18" TextWrapping="Wrap"/><WrapPanel><Button x:Name="CheckUpdateButton" Content="Controlla aggiornamenti" Click="CheckUpdates"/><Button x:Name="InstallUpdateButton" Content="Scarica e installa" Style="{StaticResource Primary}" Click="InstallUpdate" IsEnabled="False"/></WrapPanel><ProgressBar x:Name="DownloadProgress" Height="5" Margin="0,18,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource Accent}"/></StackPanel></Border>
    <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E1E8ED" BorderThickness="1" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="LoLler111 / AppAvvio" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Diario delle versioni" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBox Grid.Row="1" x:Name="Changelog" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" FontSize="14" Text="Le note delle release appariranno qui. Lo storico scaricato rimane disponibile anche offline."/></Grid></Border>
   </Grid>
   <TextBlock Grid.Row="1" x:Name="StatusText" Text="Pronto. Inizia dalle app che contano per te." Margin="0,16,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
