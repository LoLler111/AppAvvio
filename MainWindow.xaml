<Window x:Class="AppAvvio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppAvvio" Icon="Assets/Branding/appavvio.ico" Width="1180" Height="800" MinWidth="900" MinHeight="620" Background="#F4F7FA" WindowStartupLocation="CenterScreen">
 <Grid Background="#F4F7FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142838"><Grid Margin="16,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#F4F7FA" CornerRadius="14" Padding="10,14"><Image Source="Assets/Branding/appavvio-logo.png" Stretch="Uniform" AutomationProperties.Name="AppAvvio"/></Border><TextBlock Text="Un inizio più semplice." Foreground="#BDCAD5" Margin="4,12,0,0" FontSize="12"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,32,0,0">
    <RadioButton x:Name="SequenceNav" Content="La tua sequenza" Style="{StaticResource Navigation}" IsChecked="True" Checked="ShowSequence"/>
    <RadioButton x:Name="WindowsNav" Content="Avvio di Windows" Style="{StaticResource Navigation}" Checked="ShowWindows"/>
    <RadioButton x:Name="UpdatesNav" Content="Aggiornamenti" Style="{StaticResource Navigation}" Checked="ShowUpdates"/>
   </StackPanel>
   <StackPanel Grid.Row="2"><TextBlock Text="Le tue app. I tuoi tempi." Foreground="#BDCAD5" FontSize="12"/><TextBlock x:Name="SidebarVersion" Foreground="#94ADBF" Margin="0,8,0,0" FontSize="12"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="SequencePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Le tue app, nell’ordine giusto." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Scegli cosa aprire quando accedi a Windows. Al resto pensa AppAvvio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="#E8F4F0" CornerRadius="12" Padding="12" Margin="0,0,0,16"><DockPanel>
     <Button x:Name="StartupOptionsButton" DockPanel.Dock="Right" Content="Opzioni" Click="OpenStartupOptions" Padding="10,6" Margin="12,0,0,0"/>
     <CheckBox x:Name="LoginCheck" Content="Apri la mia sequenza quando accedo a Windows" Click="ToggleLogin" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Popup x:Name="StartupOptions" PlacementTarget="{Binding ElementName=StartupOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Style="{StaticResource Card}" Padding="20" Margin="0,6,0,0" Width="380"><StackPanel>
      <TextBlock Text="Un avvio discreto" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
      <CheckBox x:Name="QuietCheck" Click="ToggleQuiet"><TextBlock Text="All’accesso, non mostrare la finestra" TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="AppAvvio resta nell’area di notifica, vicino all’orologio. Puoi riaprirlo da lì o dalla sua icona nel menu Start." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="23,10,0,0"/>
      <TextBlock x:Name="SequenceHealthText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel></Border></Popup>
    </DockPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="18"><Button x:Name="AddButton" DockPanel.Dock="Right" Content="＋  Aggiungi app" Style="{StaticResource Primary}" Click="AddApp" Margin="12,0,0,0"/><StackPanel><TextBlock Text="La tua sequenza" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SequenceSummary" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1">
      <DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F4" BorderThickness="0" Background="White" MinRowHeight="72" SelectionMode="Single" SelectionUnit="FullRow" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" MouseMove="DragMove" Drop="DropItem" MouseDoubleClick="EditSelected" SelectionChanged="SequenceSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Attiva" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="ToggleItem" AutomationProperties.Name="{Binding Name, StringFormat=Avvio di {0}}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Applicazione" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Order}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding HealthLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Health}"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Attesa" Binding="{Binding DelayLabel}" Width="130"/>
        <DataGridTextColumn Header="Esecuzione" Binding="{Binding Status}" Width="155"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Status}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20,38,20,0"><TextBlock Text="Cominciamo dalla prima app" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Premi Aggiungi app e scegli ciò che usi ogni giorno." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
     </Grid>
     <WrapPanel x:Name="EditActions" Grid.Row="2" Margin="16"><Button x:Name="UpButton" Content="↑" AutomationProperties.Name="Sposta in alto" ToolTip="Sposta in alto" Click="MoveUp"/><Button x:Name="DownButton" Content="↓" AutomationProperties.Name="Sposta in basso" ToolTip="Sposta in basso" Click="MoveDown"/><Button x:Name="EditButton" Content="Modifica" Click="EditSelected"/><Button x:Name="RemoveButton" Content="Togli dalla sequenza" Click="RemoveApp"/></WrapPanel>
    </Grid></Border>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SaveState" Text="Le modifiche si salvano automaticamente" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Trascina le app o usa le frecce per riordinarle." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RunButton" Content="Avvia adesso" Style="{StaticResource Primary}" Click="Run"/><Button x:Name="StopButton" Content="Interrompi" Click="Stop" IsEnabled="False" Margin="0"/></StackPanel></Grid>
   </Grid>
   <Grid x:Name="WindowsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Cosa si apre con Windows" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Porta un’app nella tua sequenza per sceglierne ordine e attesa." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,16"><TextBlock Text="Cerca un’app" Margin="0,0,0,6"/><TextBox x:Name="WindowsSearch" TextChanged="FilterWindows" AutomationProperties.Name="Cerca negli avvii di Windows"/><CheckBox x:Name="ShowSystemCheck" Content="Mostra anche le voci di sistema e quelle da gestire manualmente" Click="FilterWindows" Margin="0,12,0,0"/><TextBlock x:Name="WindowsStatus" Text="Sto cercando le app…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><ListBox x:Name="WindowsApps" SelectionChanged="WindowsSelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FriendlyDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,5,10,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding EnabledLabel}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><WrapPanel><Button x:Name="ImportButton" Content="Sposta nella sequenza" Style="{StaticResource Primary}" Click="ImportSelected" IsEnabled="False"/><Button x:Name="ToggleStartupButton" Content="Disattiva avvio" Click="ToggleWindowsStartup" IsEnabled="False"/><Button x:Name="RefreshButton" Content="Aggiorna elenco" Click="RefreshWindows"/></WrapPanel><Button Content="Apri le impostazioni di Windows ↗" Click="OpenStartupSettings" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
   </Grid>
   <Grid x:Name="UpdatesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="Un’app sempre al passo." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Tutte le novità e gli aggiornamenti di AppAvvio." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatus" Text="Controlla se è disponibile una nuova versione." Foreground="{StaticResource Muted}" Margin="0,8,0,16" TextWrapping="Wrap"/><WrapPanel><Button x:Name="CheckUpdateButton" Content="Controlla aggiornamenti" Click="CheckUpdates"/><Button x:Name="InstallUpdateButton" Content="Scarica e installa" Style="{StaticResource Primary}" Click="InstallUpdate" IsEnabled="False"/></WrapPanel><ProgressBar x:Name="DownloadProgress" Height="5" Margin="0,16,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource Accent}"/></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Le novità" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBox Grid.Row="1" x:Name="Changelog" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" Text="Premi Controlla aggiornamenti per leggere le novità. Potrai rileggerle anche senza connessione."/></Grid></Border>
   </Grid>
   <TextBlock Grid.Row="1" x:Name="StatusText" Text="Scegli le tue app per cominciare." Margin="0,16,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
 </Grid>
</Window>
